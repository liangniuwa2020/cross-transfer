<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Dialog Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPickerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📂 选择接收保存的文件夹"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvPickerClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textSize="20sp"
                android:textColor="#64748B"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Current Path Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickerBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⬆️ 上一级"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:backgroundTint="#F1F5F9"
                android:textColor="#334155"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickerRoot"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🏠 根目录"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:backgroundTint="#F1F5F9"
                android:textColor="#334155"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvPickerCurrentPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="/storage/emulated/0"
                android:textColor="#475569"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="start" />
        </LinearLayout>

        <!-- Shortcut chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥 Download"
                    android:textColor="#1D4ED8"
                    android:textSize="12sp"
                    android:background="#EFF6FF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipDCIM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 DCIM相册"
                    android:textColor="#15803D"
                    android:textSize="12sp"
                    android:background="#F0FDF4"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipPictures"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Pictures"
                    android:textColor="#7E22CE"
                    android:textSize="12sp"
                    android:background="#FAF5FF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipDocuments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 Documents"
                    android:textColor="#B45309"
                    android:textSize="12sp"
                    android:background="#FEF3C7"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Subfolders RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPickerFolders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvPickerEmpty"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:gravity="center"
        android:text="此目录下无子文件夹\n可直接选定当前目录作为保存位置"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Bottom Action Confirmation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#F8FAFC"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickerNewFolder"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="➕ 新建文件夹"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#F1F5F9"
            android:textColor="#334155"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickerSelectCurrent"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="✅ 选定此文件夹保存"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
