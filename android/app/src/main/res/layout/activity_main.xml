<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跨屏快传"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android ⇄ Windows 免流量超快直传"
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="📷 扫码互联"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Device Connection Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewStatusDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/ic_launcher_background"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="未连接电脑 (请点击右上角扫码)"
                            android:textColor="#334155"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDisconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="断开"
                            android:textColor="#EF4444"
                            android:textSize="13sp"
                            android:visibility="gone"
                            android:padding="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPcAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="电脑端打开配套软件，将自动生成连接二维码"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />

                    <!-- Action Buttons when connected -->
                    <LinearLayout
                        android:id="@+id/layoutConnectedActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenPhoneStorage"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="📂 进入手机存储"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8"
                            app:backgroundTint="#EFF6FF"
                            app:strokeColor="#BFDBFE"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualDisconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="🔌 断开连接"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626"
                            app:backgroundTint="#FEF2F2"
                            app:strokeColor="#FECACA"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <!-- Permission prompt card when MANAGE_EXTERNAL_STORAGE is missing -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutManageStorageBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#FCD34D"
                        app:cardBackgroundColor="#FEF3C7"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🛡️ 开启全盘文件管理权限，电脑端可自由浏览手机各文件夹"
                                android:textSize="12sp"
                                android:textColor="#B45309" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGrantManageStorage"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="去开启"
                                android:textSize="12sp"
                                android:textColor="#FFFFFF"
                                app:backgroundTint="#F59E0B"
                                app:cornerRadius="6dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Manual IP input expandable row -->
                    <LinearLayout
                        android:id="@+id/layoutManualConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etManualIp"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/border_input"
                            android:hint="或手动输入电脑IP (如 192.168.1.5)"
                            android:textSize="13sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualConnect"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="连接"
                            android:textSize="13sp"
                            android:layout_marginStart="8dp"
                            app:backgroundTint="#3B82F6"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons: Send to PC -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发送给电脑"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSendAnyFile"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#EFF6FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BFDBFE">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 文件 / 压缩包"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="zip, rar, pdf, doc, apk..."
                            android:textSize="11sp"
                            android:textColor="#3B82F6"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSendMedia"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F0FDF4"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BBF7D0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖼️ 照片 / 视频"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#15803D" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="原图、4K视频无压缩传输"
                            android:textSize="11sp"
                            android:textColor="#16A34A"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Live Transfer Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CBD5E1"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTransferFilename"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="正在传输: file.zip"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvTransferPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45%"
                            android:textColor="#2563EB"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        app:indicatorColor="#2563EB"
                        app:trackColor="#E2E8F0"
                        app:trackCornerRadius="4dp"
                        android:progress="45" />

                    <TextView
                        android:id="@+id/tvTransferSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="传输速度: 32.5 MB/s"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- File Transfer History / Received Files -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="传输与接收记录"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:padding="6dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="暂无传输记录\n两端连接后即可任意收发文件"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
